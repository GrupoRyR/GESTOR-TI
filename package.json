{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "dev:preview": "vite --config ui-preview/vite.config.ts",
        "build:preview": "vite build --config ui-preview/vite.config.ts",
        "preview:dist": "vite preview --config ui-preview/vite.config.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@inertiajs/react": "^3.8.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@fontsource-variable/bricolage-grotesque": "^5.3.0",
        "@fontsource-variable/figtree": "^5.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.3",
        "vitest": "^5.0.3"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
