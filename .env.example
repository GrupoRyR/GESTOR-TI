APP_NAME="Gestor TI RYR"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# MySQL 8 on cPanel (utf8mb4)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Shared hosting: database queue processed by cron (schedule:run)
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Microsoft 365 SMTP
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Microsoft Entra ID (multitenant app registration)
MICROSOFT_CLIENT_ID=
# Client secret from the app registration (never commit it)
MICROSOFT_CLIENT_SECRET=
# e.g. https://your-domain/auth/microsoft/callback
MICROSOFT_REDIRECT_URI=
# "organizations" = any work/school tenant; allowed tenants are filtered by active companies
MICROSOFT_TENANT=organizations

# Local emergency login (single admin account)
EMERGENCY_ADMIN_EMAIL=

# Telegram bot for notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random secret included in the webhook URL
TELEGRAM_WEBHOOK_SECRET=

# DeepSeek API (Gestor IA)
DEEPSEEK_API_KEY=

# Key used to encrypt the credentials vault (separate from APP_KEY)
VAULT_KEY=

# GitHub App / token (Gestor IA repository integration)
GITHUB_APP_ID=
# Absolute path to the GitHub App private key (.pem) outside public_html
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
